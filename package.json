{
  "name": "@illyism/transcribe",
  "version": "4.2.0",
  "description": "CLI tool to transcribe audio/video files to SRT format using OpenAI Whisper API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "transcribe": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --format esm --external openai --external @clack/prompts && bun build src/index.ts --outdir dist --target node --format esm --external openai && chmod +x dist/cli.js",
    "dev": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build",
    "prepare": "husky"
  },
  "keywords": [
    "transcribe",
    "whisper",
    "openai",
    "srt",
    "subtitles",
    "audio",
    "video",
    "speech-to-text",
    "cli"
  ],
  "author": "Ilias Ismanalijev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Illyism/transcribe-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Illyism/transcribe-cli/issues"
  },
  "homepage": "https://github.com/Illyism/transcribe-cli#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "cli-progress": "^3.12.0",
    "openai": "^7.57.0",
    "picocolors": "^1.1.1"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/cli-progress": "^3.11.6",
    "husky": "^9.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
